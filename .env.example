# Optional Discord alerts. The analysis pipeline can run without it.
DISCORD_WEBHOOK_URL=

# Optional Groq-compatible AI enrichment.
GROQ_API_KEY=

# Optional eBay Browse API price refresh.
EBAY_ENV=sandbox
EBAY_OAUTH_TOKEN=

# eBay marketplace account deletion/closure notification endpoint.
# Keep the token empty here; use an uncommitted .env or hosting-provider secret.
EBAY_ACCOUNT_DELETION_TOKEN=
EBAY_ACCOUNT_DELETION_ENDPOINT=

# Scan and filtering settings (default is Rochester, NY)
HOME_LAT=43.0831
HOME_LON=-77.6743
MAX_RADIUS_MILES=100
MIN_PROFIT=100
MIN_DEAL_SCORE=55
