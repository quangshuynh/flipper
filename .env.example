# Optional Discord alerts. The analysis pipeline can run without it.
DISCORD_WEBHOOK_URL=

# Optional Groq-compatible AI enrichment.
GROQ_API_KEY=

# Local authoritative storage. Blank uses the repository defaults.
FLIPPER_INVENTORY_DB=
FLIPPER_ATTACHMENT_ROOT=

# Legacy eBay Browse API price refresh.
# Uses a manually supplied OAuth token.
EBAY_ENV=sandbox
EBAY_OAUTH_TOKEN=

# eBay Deals discovery (optional).
# Provides read-only listing discovery through the eBay Browse API.
# Flipper obtains an application access token automatically using the
# environment-specific Client ID (App ID) and Client Secret (Cert ID).
#
# Supported environments: sandbox, production
# Credentials must belong to the same environment selected below.
# Never commit real eBay credentials.
EBAY_DISCOVERY_ENV=sandbox
EBAY_DISCOVERY_CLIENT_ID=
EBAY_DISCOVERY_CLIENT_SECRET=
EBAY_DISCOVERY_MARKETPLACE=EBAY_US

# eBay marketplace account deletion/closure notification endpoint.
# Keep the token empty here; use an uncommitted .env or hosting-provider secret.
EBAY_ACCOUNT_DELETION_TOKEN=
EBAY_ACCOUNT_DELETION_ENDPOINT=

# eBay application credentials used only to retrieve notification public keys.
# These credentials must match EBAY_NOTIFICATION_ENV.
EBAY_NOTIFICATION_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Personal seller OAuth.
# Separate from Deals discovery and notification configuration.
# Use the App ID, Cert ID, and RuName from the same eBay environment.
EBAY_SELLER_ENV=production
EBAY_SELLER_CLIENT_ID=
EBAY_SELLER_CLIENT_SECRET=
EBAY_SELLER_RUNAME=

# Scan and filtering settings (default is Rochester, NY).
HOME_LAT=43.0831
HOME_LON=-77.6743
MAX_RADIUS_MILES=100
MIN_PROFIT=100
MIN_DEAL_SCORE=55
